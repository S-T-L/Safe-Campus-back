# Variables consommees par docker-compose.prod.yml (a saisir dans Dockploy, pas
# de fichier .env copie dans l'image en prod). A garder synchronise avec le bloc
# `environment:` de docker-compose.prod.yml si l'un des deux change.

APP_PORT=8000

# genere une fois avec `php artisan key:generate --show`, colle la valeur ici.
# Ne JAMAIS regenerer a chaque deploiement : ca invalide sessions/cookies/donnees
# chiffrees existantes.
APP_KEY=

# URL publique HTTPS du back.
APP_URL=https://api.safe-campus.example

DB_DATABASE=sc_back
DB_USERNAME=
# mot de passe fort (min. 20 caracteres, aleatoire), jamais celui du .env dev.
DB_PASSWORD=

# URL publique du front (Nuxt), pour CORS et Sanctum stateful.
CORS_ALLOWED_ORIGINS=https://safe-campus.example
SANCTUM_STATEFUL_DOMAINS=safe-campus.example
