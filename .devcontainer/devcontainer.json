{
  "name": "SC_Back",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "sc_back",
  "workspaceFolder": "/var/www/html",
  "remoteUser": "sail",
  "forwardPorts": [8000, 5432, 8080, 3000, 24678],
  "portsAttributes": {
    "8000": { "label": "Laravel", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "8080": { "label": "Adminer", "onAutoForward": "notify" },
    "3000": { "label": "Nuxt", "onAutoForward": "openBrowser" },
    "24678": { "label": "Vite HMR", "onAutoForward": "silent" }
  },
  "initializeCommand": "test -f .env || (cp .env.example .env && sed -i \"s/^WWWUSER=.*/WWWUSER=$(id -u)/\" .env && sed -i \"s/^WWWGROUP=.*/WWWGROUP=$(id -g)/\" .env)",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        // PHP core
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug",
        "devsense.composer-php-vscode",
        "lkrms.pretty-php",
        // Laravel
        "onecentlin.laravel5-snippets",
        "amiralizadeh9480.laravel-extra-intellisense",
        "ryannaddy.laravel-artisan",
        "naoray.laravel-goto-components",
        "pgl.laravel-jump-controller",
        "alperenersoy.filament-snippets",
        "shufo.vscode-blade-formatter",
        // Images
        "kisstkondoros.vscode-gutter-preview",
        // Indentation
        "oderwat.indent-rainbow",
        // Base de données
        "cweijan.vscode-postgresql-client2",
        // Config & environnement
        "mikestead.dotenv",
        "redhat.vscode-yaml",
        // Qualité de code
        "streetsidesoftware.code-spell-checker",
        // Markdown
        "bierner.markdown-mermaid",
        "yzhang.markdown-all-in-one",
        // IA
        "github.copilot",
        "github.copilot-chat",
        // Git
        "waderyan.gitblame",
        "mhutchie.git-graph",
        "vector-of-bool.gitflow",
        "rturock.gitstash"
      ],
      "settings": {
        "php.executablePath": "/usr/local/bin/php",
        "intelephense.environment.phpVersion": "8.4",
        "editor.formatOnSave": true,
        "[php]": {
          "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
        },
        "[blade]": {
          "editor.defaultFormatter": "shufo.vscode-blade-formatter"
        },
        "launch": {
          "version": "0.2.0",
          "configurations": [
            {
              "name": "Listen for Xdebug",
              "type": "php",
              "request": "launch",
              "port": 9003,
              "pathMappings": {
                "/var/www/html": "${workspaceFolder}"
              }
            }
          ]
        }
      }
    }
  }
}
